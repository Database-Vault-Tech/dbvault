# =============================================================================
# DBVault configuration
#
# Quick start:     cp .env.example .env && docker compose up -d
# Recommended:     ./scripts/setup.sh    (writes .env with strong random values)
#
# The values below marked "local-dev" only protect services that are NOT
# exposed outside the Docker network. Change them (or run setup.sh) before
# running DBVault anywhere other than your laptop.
# =============================================================================

# --- Application -------------------------------------------------------------

# Public URL of the web app. Used for links in emails and for the CSRF
# Origin check, so it must match what users type in their browser.
APP_URL=http://localhost:3000
# Host port the web app is published on.
APP_PORT=3000
# Address the web app is published on. Only used by docker-compose.prod.yml;
# set to 127.0.0.1 when a reverse proxy in front of it terminates TLS.
APP_BIND=0.0.0.0
# production | development (development only changes log verbosity defaults).
DBVAULT_ENV=production
# debug | info | warn | error
LOG_LEVEL=info
# Allow anyone who can reach the app to register. The first account can
# always be created; set to false afterwards and invite teammates instead.
ALLOW_REGISTRATION=true
# Comma-separated emails of the people who run this installation. They get a
# read-only "Instance admin" area listing every organization, user, database
# and backup — never credentials, storage settings or backup contents. Register
# these accounts yourself before opening sign-up to anyone else.
INSTANCE_ADMIN_EMAILS=
# Mark cookies Secure. Defaults to true when APP_URL starts with https://.
COOKIE_SECURE=

# --- Secrets -------------------------------------------------------------------

# Leave empty to have DBVault generate strong values on first start and store
# them in the dbvault-secrets Docker volume (secrets.env).
#
# ENCRYPTION_KEY protects every stored credential and every organization's
# backup key. If you lose it, encrypted backups CANNOT be decrypted.
# Back it up (and export each organization's recovery key in Settings →
# Security). Generate your own with: openssl rand -base64 32
ENCRYPTION_KEY=
# Signs CSRF tokens and keys the hashes of session/API tokens (32+ chars).
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# --- Metadata database (DBVault's own PostgreSQL) --------------------------------

POSTGRES_USER=dbvault
POSTGRES_DB=dbvault
# local-dev value: change it (the database is not published outside Docker).
POSTGRES_PASSWORD=dbvault-local-dev-postgres

# To use an external PostgreSQL/Redis instead of the bundled ones, set these
# on the api/worker/scheduler services (see docs/development.md):
# DATABASE_URL=postgres://user:pass@host:5432/dbvault?sslmode=require
# REDIS_URL=redis://host:6379/0

# --- Built-in S3-compatible storage (MinIO) ------------------------------------

# Root credentials for the bundled MinIO (console on http://localhost:9001).
MINIO_ROOT_USER=dbvault-admin
# local-dev value: change it.
MINIO_ROOT_PASSWORD=dbvault-local-dev-minio
MINIO_CONSOLE_PORT=9001
# Bucket and least-privilege service account DBVault uses. minio-init creates
# both on startup; the account can only access this bucket.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=dbvault-backups
S3_ACCESS_KEY=dbvault-backups
# local-dev value: change it.
S3_SECRET_KEY=dbvault-local-dev-s3-secret

# --- Workers -------------------------------------------------------------------

# Jobs (backups, restores, verifications) each worker runs in parallel.
WORKER_CONCURRENCY=2
# How long a stopping worker waits for running jobs before cancelling them.
WORKER_SHUTDOWN_GRACE_PERIOD=5m
# Re-download every backup after upload and re-check its SHA-256 before
# marking it completed. Doubles egress for remote storage; recommended.
VERIFY_UPLOADED_DATA=true

# --- Landing page ----------------------------------------------------------------

# Show the marketing landing page at "/". Off by default: a self-hosted install
# opens on the sign-in screen (or the dashboard when already signed in). Only
# the public dbvault.tech site needs this. Takes effect on restart, no rebuild.
LANDING_PAGE=false

# Public URL of the landing page: canonical links, sitemap, robots.txt and
# social share cards. Baked into the frontend image at build time, so changing
# it here only takes effect on the next image build.
SITE_URL=https://dbvault.tech

# --- SQLite ---------------------------------------------------------------------

# Folder on this machine holding the SQLite database files to protect. It is
# mounted into the api and worker containers at /sqlite; databases are added
# by their path inside it (e.g. myapp/app.db). The containers run as uid
# 10001, which needs read and write access: sudo chown -R 10001 <folder>
# (or give a group both of you share rw). Every organization on this instance
# can reach every file in it, so only mount what you mean to protect.
SQLITE_HOST_DIR=./data/sqlite

# --- Restore verification ------------------------------------------------------

# How "Verify backup" restore tests run:
#   server   - throwaway database on the bundled verify-postgres (default, no Docker socket needed)
#   docker   - temporary PostgreSQL container matching each backup's major version
#              (use docker-compose.verify-docker.yml; requires the Docker socket)
#   disabled - integrity checks only; the UI reports "Restore testing unavailable"
VERIFY_MODE=server
# local-dev value: change it. Superuser password of the verify-postgres sandbox.
VERIFY_POSTGRES_PASSWORD=dbvault-local-dev-verify
# Root password of the disposable MySQL/MariaDB verification servers
# (defaults to VERIFY_POSTGRES_PASSWORD).
VERIFY_MYSQL_PASSWORD=dbvault-local-dev-verify
# Group id owning /var/run/docker.sock (only for VERIFY_MODE=docker).
DOCKER_GID=999

# --- Email ---------------------------------------------------------------------

# Defaults send everything to the bundled Mailpit (http://localhost:8025).
# For real delivery use your provider, e.g. SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587 SMTP_TLS=starttls.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DBVault <dbvault@localhost>
# starttls | tls | none
SMTP_TLS=none
MAILPIT_PORT=8025

# --- Security ------------------------------------------------------------------

# Allow webhooks to private/loopback addresses. Self-hosted installs usually
# want this; set to false for multi-tenant/hosted deployments (SSRF protection).
ALLOW_PRIVATE_NETWORK_TARGETS=true
# Requests per minute per client for login/registration and for the API.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=600

# Image tag used for the dbvault/* images built by docker compose.
DBVAULT_VERSION=dev
